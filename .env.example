# ===========================================
# NASH SATOSHI - ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and fill in your values
# Required variables are marked with [REQUIRED]
# Optional variables have default values shown

# ===========================================
# DATABASE (PostgreSQL/Neon)
# ===========================================
# [REQUIRED] PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Connection pool size (default: 20, Neon free tier max: 20)
DB_POOL_MAX=20

# ===========================================
# AUTHENTICATION (Supabase)
# ===========================================
# [REQUIRED] Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PROJECT_URL=https://your-project.supabase.co

# [REQUIRED] Supabase anon/public key (for client-side)
VITE_SUPABASE_ANON_KEY=your-anon-key

# [REQUIRED] Supabase service role key (for server-side, keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# PAYMENTS (Stripe)
# ===========================================
# [REQUIRED] Stripe secret key (use live key for production)
STRIPE_SECRET_KEY=sk_live_or_sk_test_...

# [REQUIRED] Stripe webhook signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# [REQUIRED] Stripe price IDs for subscription tiers
# Create these in your Stripe dashboard
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_TRADER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_DESK_PRICE_ID=price_...

# ===========================================
# AI ANALYSIS (Gumloop)
# ===========================================
# [REQUIRED] Gumloop API key
GUMLOOP_API_KEY=your-gumloop-api-key

# [REQUIRED] Gumloop pipeline ID (your saved pipeline)
GUMLOOP_PIPELINE_ID=your-pipeline-id

# [REQUIRED] Gumloop user ID
GUMLOOP_USER_ID=your-user-id

# [OPTIONAL] Gumloop webhook URL for starting analyses
GUMLOOP_WEBHOOK_URL=

# [RECOMMENDED] Gumloop webhook secret for verification
GUMLOOP_WEBHOOK_SECRET=

# ===========================================
# MARKET DATA (CoinGecko)
# ===========================================
# [OPTIONAL] CoinGecko API key (improves rate limits)
COINGECKO_API_KEY=

# [OPTIONAL] CoinGecko API type: "demo" or "pro" (default: demo)
COINGECKO_API_TYPE=demo

# ===========================================
# CACHING (Upstash Redis)
# ===========================================
# [OPTIONAL] Upstash Redis REST URL (enables caching & distributed rate limiting)
UPSTASH_REDIS_REST_URL=

# [OPTIONAL] Upstash Redis REST token
UPSTASH_REDIS_REST_TOKEN=

# ===========================================
# SERVER CONFIGURATION
# ===========================================
# Server port (default: 5000)
PORT=5000

# Node environment: "development" or "production"
NODE_ENV=production

# [OPTIONAL] CORS origin (default: allows all in dev, configure for production)
# Example: https://yourdomain.com
CORS_ORIGIN=

# ===========================================
# PRODUCTION CHECKLIST
# ===========================================
# Before going live, ensure you have:
# [ ] Set NODE_ENV=production
# [ ] Configured all [REQUIRED] variables above
# [ ] Set up Stripe webhook endpoint: https://yourdomain.com/api/webhook/stripe
# [ ] Set up Gumloop webhook endpoint: https://yourdomain.com/api/webhook/gumloop
# [ ] Applied database migrations (npm run db:push)
# [ ] Applied production indexes (migrations/0002_add_production_indexes.sql)
# [ ] Configured Upstash Redis for optimal performance
# [ ] Set CORS_ORIGIN to your production domain
