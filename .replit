modules = ["nodejs-20", "web", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 15050
externalPort = 5173
exposeLocalhost = true

[[ports]]
localPort = 16185
externalPort = 8000
exposeLocalhost = true

[[ports]]
localPort = 18247
externalPort = 3002
exposeLocalhost = true

[[ports]]
localPort = 27897
externalPort = 4200
exposeLocalhost = true

[[ports]]
localPort = 28542
externalPort = 5000
exposeLocalhost = true

[[ports]]
localPort = 28778
externalPort = 6000
exposeLocalhost = true

[[ports]]
localPort = 29346
externalPort = 3003
exposeLocalhost = true

[[ports]]
localPort = 62480
externalPort = 3000
exposeLocalhost = true

[[ports]]
localPort = 65312
externalPort = 3001
exposeLocalhost = true

[env]
PORT = "5000"

[deployment]
deploymentTarget = "autoscale"
run = ["node", "./dist/index.cjs"]
build = ["npm", "run", "build"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000
